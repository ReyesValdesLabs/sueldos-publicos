---
import AdSlot from "@/components/AdSlot.astro";
import AdministrativeCalculator from "@/components/AdministrativeCalculator";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  breadcrumbStructuredData,
  calculatorStructuredData,
  webPageStructuredData,
} from "@/lib/structured-data";

const title = "Calculadora para administrativos DAEM y municipales | Sueldos Públicos";
const description = "Estima la liquidación de administrativos en establecimientos municipales, nivel central DAEM/DEM o municipalidades, con recorridos separados según el régimen contractual.";
const path = "calculadoras/administrativos-municipales/";
const structuredData = [
  webPageStructuredData({ name: title, description, path }),
  calculatorStructuredData({
    name: "Calculadora para administrativos DAEM y municipales",
    description,
    path,
  }),
  breadcrumbStructuredData([
    { name: "Inicio", path: "" },
    { name: "Administrativos DAEM y municipales", path },
  ]),
];
---
<BaseLayout title={title} description={description} structuredData={structuredData} adsense>
  <header class="calculator-page-header page-shell">
    <span class="eyebrow">Tres regímenes, fórmulas separadas</span>
    <h1>Administrativos DAEM y municipales</h1>
    <p>Identifica si trabajas dentro de un establecimiento educacional, en el nivel central DAEM/DEM o como funcionario/a municipal de planta o contrata. La calculadora cambia los haberes y descuentos según tu vínculo.</p>
  </header>
  <div class="page-shell calculator-page-content">
    <AdministrativeCalculator client:load />
  </div>
  <AdSlot placement="después de la calculadora administrativa" />
</BaseLayout>
