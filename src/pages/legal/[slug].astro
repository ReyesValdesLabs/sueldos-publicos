---
import { ArrowLeft, ExternalLink, Scale } from "lucide-react";
import { LEGAL_ENTRIES, type LegalEntry } from "@/data/legal";
import { LEGAL_CONTENT_PUBLISHED_AT, LEGAL_CONTENT_REVIEWED_AT, SITE } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/lib/site-path";
import { breadcrumbStructuredData } from "@/lib/structured-data";

export function getStaticPaths() {
  return LEGAL_ENTRIES.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: LegalEntry }
const { entry } = Astro.props;
const currency = new Intl.NumberFormat("es-CL", {
  style: "currency",
  currency: "CLP",
  maximumFractionDigits: 0,
});
const entryPath = `legal/${entry.slug}/`;
const entryUrl = new URL(entryPath, SITE.url).href;
const pageTitle = `${entry.title} | Respaldo legal | Sueldos Públicos`;
const reviewedLabel = new Intl.DateTimeFormat("es-CL", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "America/Santiago",
}).format(new Date(`${LEGAL_CONTENT_REVIEWED_AT}T12:00:00Z`));
const legalStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${entryUrl}#article`,
    headline: entry.title,
    description: entry.summary,
    url: entryUrl,
    mainEntityOfPage: entryUrl,
    inLanguage: "es-CL",
    datePublished: LEGAL_CONTENT_PUBLISHED_AT,
    dateModified: LEGAL_CONTENT_REVIEWED_AT,
    image: [SITE.socialImageUrl],
    author: { "@id": SITE.editorialAuthorId },
    publisher: { "@id": SITE.organizationId },
    isPartOf: { "@id": SITE.websiteId },
    citation: entry.sources.map((source) => source.url),
  },
  breadcrumbStructuredData([
    { name: "Inicio", path: "" },
    { name: "Respaldo legal", path: "legal/" },
    { name: entry.title, path: entryPath },
  ]),
];
---
<BaseLayout title={pageTitle} description={entry.summary} type="article" author={SITE.editorialAuthorName} structuredData={legalStructuredData}>
  <header class="page-header page-shell"><a href={sitePath("legal/")} class="eyebrow normal-case tracking-normal"><ArrowLeft size={16} /> Volver a respaldo legal</a><h1>{entry.title}</h1><p>{entry.summary}</p><p class="content-meta">Elaborado y revisado por <a href={sitePath("acerca-de/#victor-reyes-medina")}>{SITE.editorialAuthorName}</a> · Última revisión: {reviewedLabel}</p></header>
  <div class="page-shell legal-detail">
    <article class="legal-content">
      <h2>A quién se aplica</h2><p>{entry.appliesTo}</p>
      <h2>Cómo lo calcula esta herramienta</h2>{entry.explanation.map((paragraph) => <p>{paragraph}</p>)}
      <div class="formula" aria-label="Fórmula utilizada">{entry.formula}</div>
      {entry.amountTable && (
        <section class="legal-amount-section" aria-labelledby="official-values-title">
          <h2 id="official-values-title">{entry.amountTable.title}</h2>
          <p>{entry.amountTable.description}</p>
          <div class="legal-amount-table-scroll">
            <table class="legal-amount-table">
              <thead>
                <tr>
                  <th scope="col">Componente</th>
                  <th scope="col">Tramo o nivel</th>
                  <th scope="col">Monto</th>
                </tr>
              </thead>
              <tbody>
                {entry.amountTable.groups.map((group) =>
                  group.rows.map((row, index) => (
                    <tr>
                      {index === 0 && <th scope="rowgroup" rowspan={group.rows.length}>{group.component}</th>}
                      <th scope="row">{row.label}</th>
                      <td>{currency.format(row.amount)}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
          <ul class="legal-amount-notes">
            {entry.amountTable.notes.map((note) => <li>{note}</li>)}
          </ul>
          <a class="legal-amount-source" href={entry.amountTable.source.url} target="_blank" rel="noopener noreferrer">
            {entry.amountTable.source.label} <ExternalLink size={14} />
          </a>
        </section>
      )}
      <h2>Consideraciones</h2><ul>{entry.notes.map((note) => <li>{note}</li>)}</ul>
      <p class="mt-8 rounded-xl bg-muted p-4 text-sm">Esta página explica la implementación de la calculadora y no reemplaza una interpretación jurídica aplicada a un caso particular.</p>
      <p class="text-sm">Consulta nuestra <a href={sitePath("metodologia/")}>metodología de fuentes, revisión y actualización</a> o <a href={sitePath("contacto/")}>reporta una posible corrección</a>.</p>
    </article>
    <aside><div class="source-box"><Scale size={24} className="text-primary" /><h2 class="mt-3 font-bold">Fuentes oficiales</h2><p class="text-sm leading-6 text-muted-foreground">Enlaces consultados para documentar el concepto y sus parámetros.</p>{entry.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <ExternalLink size={14} className="inline" /></a>)}</div></aside>
  </div>
</BaseLayout>
