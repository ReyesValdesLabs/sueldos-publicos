---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/data/site";
import { sitePath } from "@/lib/site-path";
import { organizationStructuredData, personStructuredData, websiteStructuredData } from "@/lib/structured-data";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  adsense?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  image = "og.png",
  imageAlt = "Calculadoras de sueldos públicos en Chile",
  type = "website",
  noindex = false,
  adsense = false,
  structuredData,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageUrl = new URL(sitePath(image), Astro.site ?? Astro.url);
const robotsContent = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const pageStructuredData = structuredData
  ? Array.isArray(structuredData) ? structuredData : [structuredData]
  : [];
const jsonLd = JSON.stringify([
  organizationStructuredData,
  personStructuredData,
  websiteStructuredData,
  ...pageStructuredData,
]).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content={SITE.editorialAuthorName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d47a1" />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Sueldos Públicos" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href={sitePath("favicon.ico")} sizes="any" />
    {adsense && <link rel="preconnect" href="https://pagead2.googlesyndication.com" />}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("sp-theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {adsense && (
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5034305532752206"
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const applyTheme = (theme: string) => {
        const dark = theme === "dark";
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.dataset.theme = theme;
        localStorage.setItem("sp-theme", theme);
        if (themeButton) themeButton.setAttribute("aria-label", dark ? "Cambiar a tema claro" : "Cambiar a tema oscuro");
      };
      themeButton?.addEventListener("click", () => {
        const current = document.documentElement.dataset.theme || "light";
        applyTheme(current === "dark" ? "light" : "dark");
      });
      applyTheme(document.documentElement.dataset.theme || "light");
    </script>
  </body>
</html>
